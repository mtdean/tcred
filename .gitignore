# macOS
.DS_Store
**/.DS_Store

# Secrets & private working docs (not for the repo)
.env
# Local env files / backups (.env.bak, .env.local, ...) but keep the template
.env.*
!.env.example
CLAUDE.md
FRONTEND.md

# Python
backend/.venv/
__pycache__/
*.py[cod]

# SQLite cache / data
backend/cache/*.db
backend/cache/*.db-journal
backend/cache/*.db-wal
backend/cache/*.db-shm
backend/cache/store/
# Nightly rolling DB snapshots (data/backups.py)
backend/cache/backups/

# Node / frontend build
frontend/node_modules/
frontend/dist/
# Generated static-mode API snapshot (rebuilt by scripts/snapshot_api.py
# and published to the gh-pages branch).
frontend/public/api-snapshot/

# Logs
logs/*.log
logs/*.out
logs/*.err
*.out.log
*.err.log

# Claude Code local settings (local tooling config)
.claude/settings.local.json
