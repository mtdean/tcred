# Situation Monitor — environment configuration
# Copy to .env and fill in your keys.

# FRED API key — free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Anthropic API key — used by the article relevance classifier and digest
ANTHROPIC_API_KEY=

# SEC EDGAR requires a User-Agent header identifying the requester.
# Format: "AppName/Version your@email.com"
EDGAR_USER_AGENT=<TCRED>/0.1 you@email.com

# Gmail IMAP — pulls Meco-labeled newsletters into the news pipeline.
# App password: myaccount.google.com/apppasswords (needs 2-step verification).
# Leave blank to disable the Gmail ingest step entirely.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Label Meco files newsletters under. Meco typically creates a label named
# meco_<uuid> — find yours in Gmail's left sidebar (or Settings → Labels).
GMAIL_MECO_LABEL=Meco

# ntfy push alerts (config/alerts.yaml has the rules). Install the ntfy app
# on your phone, pick an UNGUESSABLE topic name (it acts as a password, e.g.
# tcred-alerts-x7k2m9), subscribe to it in the app, and set it here.
# Leave blank to disable push alerts entirely.
NTFY_TOPIC=
# Self-hosted ntfy? Point this at it. Default is the free public server.
NTFY_SERVER=https://ntfy.sh
