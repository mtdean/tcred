<?xml version="1.0" encoding="UTF-8"?>
<!--
  Situation Monitor — daily gh-pages publish (macOS LaunchAgent).
  At 07:00 local time: refresh every data source, rebuild the static
  snapshot, and push gh-pages. If the Mac is asleep at 07:00, launchd runs
  it on wake. Needs the server agent (com.situationmonitor.server) up.

  Template — __PROJECT_ROOT__ and __PATH__ are filled in by
  scripts/install_service.sh. Run now:
    launchctl kickstart gui/$(id -u)/com.situationmonitor.publish
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.situationmonitor.publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/publish_gh_pages.sh</string>
        <string>--push</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <!-- launchd's default PATH lacks Homebrew's node/npm. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/publish.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/publish.log</string>
</dict>
</plist>
